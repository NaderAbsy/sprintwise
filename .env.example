# Copy to .env and fill in. Never commit .env.

# Local: docker compose up -d   Production: the Neon or Supabase connection string
DATABASE_URL="postgresql://sprintwise:sprintwise@localhost:5432/sprintwise"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Claude API, server only. Leave blank to run without AI suggestions.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
AI_DAILY_LIMIT="20"
