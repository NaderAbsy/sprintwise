# Copy to .env and fill in. Never commit .env.

# Local: docker compose up -d   Production: the Neon or Supabase connection string
DATABASE_URL="postgresql://sprintwise:sprintwise@localhost:5432/sprintwise"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Atlassian OAuth 2.0 (3LO) app for the Jira connection (developer.atlassian.com/console/myapps).
# Leave blank to run without Jira. Callback URL: http://localhost:3000/api/auth/callback/atlassian
# Permissions: Jira API (read:jira-work, write:jira-work, read:jira-user) and User identity API (read:me).
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""
# Vercel Cron sends this to /api/cron/atlassian-accounts. Required on Vercel (the route refuses every call
# without it); optional locally. Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=""

# Claude API, server only. Leave the key blank to run without AI suggestions.
ANTHROPIC_API_KEY=""
# Optional. Blank = claude-opus-5-5. A cheaper model (e.g. claude-sonnet-5-5) cuts cost per suggestion.
ANTHROPIC_MODEL=""
# AI suggestions per user per day.
AI_DAILY_LIMIT="20"
# Suggestions per day across every account; a ceiling on cost.
AI_SITE_DAILY_LIMIT="200"
