{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/atlassian-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/jira-sync",
      "schedule": "0 22 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/cron/|google61b4ecd7775fc959\\.html).*)",
      "has": [
        {
          "type": "host",
          "value": "sprintwise-omega.vercel.app"
        }
      ],
      "destination": "https://sprintwise.app/:path",
      "permanent": true
    }
  ]
}
